{
  "name": "mon-projet-playwright",
  "version": "1.0.0",
  "description": "Projet de tests automatisés avec Playwright et TypeScript",
  "scripts": {
    "test": "bddgen && playwright test",
    "test:ui": "bddgen && playwright test --ui",
    "test:headed": "bddgen && playwright test --headed",
    "test:bdd": "bddgen && playwright test --project=bdd-chromium --project=bdd-firefox --project=bdd-webkit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "1.48.2",
    "playwright-bdd": "^7.5.0",
    "typescript": "^5.6.0"
  }
}
